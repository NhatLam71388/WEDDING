{
  "name": "ngo-nam-nhat-mai-wedding",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:public": "node scripts/sync-public.mjs",
    "predev": "npm run sync:public",
    "prebuild": "npm run sync:public",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .site-public --ignore-pattern .wrangler",
    "db:generate": "drizzle-kit generate",
    "api:dev": "wrangler dev --config wrangler.api.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.api.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.api.jsonc",
    "deploy:worker": "wrangler deploy --config wrangler.api.jsonc",
    "deploy:cloudflare": "npm run db:migrate:remote && npm run deploy:worker",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "5.20260724.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "miniflare": "4.20260722.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.1.5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.2"
  }
}
